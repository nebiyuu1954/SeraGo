# =============================================================================
# SeraGo API (.NET Backend) — Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values you have.
# Uses the ASP.NET __ -> : mapping (e.g. Aufy__Providers__Google__ClientId).
# =============================================================================

# ── Database (Neon PostgreSQL) ────────────────────────────────────────────────
# Grab the connection string from your Neon dashboard → Connection Details.
ConnectionStrings__DefaultConnection=Host=your-host;Database=your-db;Username=your-user;Password=your-password;sslmode=require

# ── Google OAuth ──────────────────────────────────────────────────────────────
# From Google Cloud Console → APIs & Services → Credentials.
# Create an OAuth 2.0 Client ID (Web application), add
#   https://localhost:5173   as authorized origin   (local dev)
#   https://localhost:5191   as authorized origin   (API callback)
Aufy__Providers__Google__ClientId=
Aufy__Providers__Google__ClientSecret=

# ── Email (EmailJS relay) ────────────────────────────────────────────────────
# Set up once in the EmailJS dashboard, then paste the values here.
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=

# ── Email Throttle ────────────────────────────────────────────────────────────
# Protects EmailJS credits from spam. Default: 3 emails per 15-min window.
EMAIL_THROTTLE_ENABLED=true
EMAIL_THROTTLE_MAX_PER_WINDOW=3
EMAIL_THROTTLE_WINDOW_MINUTES=15

# ── Notifications ─────────────────────────────────────────────────────────────
# Redis: required for unread counts + online presence tracking.
# Upstash (free tier: 10k cmds/day): https://upstash.com
# Or self-hosted: redis://localhost:6379
REDIS_CONNECTION=

# Internal API key: shared secret for Django → .NET batch notifications.
# Generate with: openssl rand -hex 32
INTERNAL_API_KEY=

# Telegram Bot (optional — leave empty to disable Telegram notifications):
# Create via @BotFather on Telegram, then paste the token here.
TELEGRAM_BOT_TOKEN=
