[TEMPLATE]
# =============================================================================
# SeraGo API (.NET Backend) — Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values you have.
# Uses the ASP.NET __ -> : mapping (e.g. Aufy__Providers__Google__ClientId).
#
# SECURITY: .env is gitignored — never commit real values. appsettings*.json
# must contain NO secrets; everything sensitive comes from the environment.
# Existing process env vars win over .env values (NoClobber).
# =============================================================================


# ════════════════════════════════════════════════════════════════════════════
# ── REQUIRED FOR PRODUCTION ──────────────────────────────────────────────────
# The app refuses to start (or a core flow is broken) if these are missing.
# ════════════════════════════════════════════════════════════════════════════

# JWT signing key. REQUIRED everywhere (dev + prod) — the app fails to start
# without it and enforces ≥ 32 bytes (256 bits). NEVER reuse the old committed
# dev key; it is considered compromised. Generate: openssl rand -base64 48
Aufy__JwtBearer__SigningKey=

# Main database (Neon PostgreSQL). REQUIRED — no DB, no app.
# Grab from your Neon dashboard → Connection Details.
# USE NEON'S DIRECT (non-pooler) endpoint. The -pooler endpoint runs PgBouncer
# in transaction mode, which breaks Hangfire's session-level advisory locks —
# jobs silently duplicate or hang with no app-log exceptions. SeraGo.API is a
# long-lived service (connections are reused), so it doesn't need the pooler.
# If you later switch EF Core to the pooler for multi-instance scaling, give
# Hangfire its own HANGFIRE_DB_CONNECTION env var pointing at the direct
# endpoint.
ConnectionStrings__DefaultConnection=Host=your-host;Database=your-db;Username=your-user;Password=your-password;sslmode=require

# EF Core pool cap. Neon free tier caps at ~20 concurrent connections SHARED by
# three pools: EF Core (this) + Hangfire (6) + SignalR backplane (2), so the
# default is budgeted: 12 + 6 + 2 = 20, exactly at the ceiling. Keys already
# present in the connection string always win over this.
DB_MAX_POOL_SIZE=12

# Bootstrap admin account (AuthSeeder). REQUIRED for production ops — without
# it no admin user is seeded and nobody can reach the admin API.
# Use a strong generated password — never reuse a committed one.
Admin__Email=
Admin__Password=

# Admin API kill switch. Unset/false UNREGISTERS every /api/admin/* endpoint
# (secure default). Set true explicitly ONLY where the admin API is needed.
ADMIN_API_ENABLED=false

# ── Email provider (pick ONE — REQUIRED in Production) ───────────────────────
# The app REFUSES TO START in Production without one of these, because
# RequireConfirmedEmail=true: with no provider, signup returns 200 ("check
# your inbox") but nothing is ever sent and users can never log in.
#
# Option A: SendGrid (recommended)
SENDGRID_API_KEY=
# Option B: EmailJS relay (for regions where classic providers are blocked)
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=
#
# Sender identity used by both providers:
FluentEmail__FromEmail=noreply@serago.example
FluentEmail__FromName=SeraGo

# Frontend origin — REQUIRED. Used for CORS and confirmation-email links.
# If wrong/missing, sign-in from the frontend fails on CORS and confirmation
# links point nowhere.
Aufy__ClientApp__BaseUrl=http://localhost:5173

# Redis — REQUIRED in Production (the app refuses to start without it there):
# unread counts fall back to per-page Postgres queries without it, and SignalR
# presence tracking is disabled. The app shares ONE multiplexer between the
# notification services and the SignalR backplane, and appends
# abortConnect=false automatically so a startup blip can't crash the boot.
# Free tier: Upstash — 10k commands/day covers a small launch:
# https://upstash.com
# Or self-hosted: redis://localhost:6379
# Optional in Development: the app degrades gracefully when unset.
REDIS_CONNECTION=

# Shared secret for the SeraGo-AI (Django) classify/match API (X-Api-Key).
# REQUIRED IF the AI features are used — AI classify/match calls fail without it.
MATCHING_API_KEY=
MATCHING_API_URL=http://localhost:8001
SERAGO_AI_URL=http://localhost:8001


# ════════════════════════════════════════════════════════════════════════════
# ── OPTIONAL (features degrade gracefully when unset) ────────────────────────
# ════════════════════════════════════════════════════════════════════════════

# Google OAuth. If empty: the Google provider is not registered, the frontend's
# Google button is hidden/disabled, and email/password still works (a startup
# WARNING is logged in Production). See setup checklist at the bottom.
Aufy__Providers__Google__ClientId=
Aufy__Providers__Google__ClientSecret=

# Cloudflare R2 storage (5 vars). If ANY is missing, avatar/resume/logo uploads
# return a clean 503 ("File uploads are not configured on this server") — the
# rest of the app keeps working. From Cloudflare dashboard → R2 → Manage API
# Tokens.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
CLOUDFLARE_ACCOUNT_ID=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# SeraGo-AI service database (read-only usage stats; separate Neon DB).
# If missing, /api/admin/ai/classification/stats reports "no data".
AI_DB_HOST=
AI_DB_PORT=5432
AI_DB_NAME=
AI_DB_USER=
AI_DB_PASSWORD=

# ── AI Classification Pipeline (5-Tier Unified Engine) ────────────────────────
# Tier 1: DeepSeek API (Primary: DeepSeek-V4.1-Flash-1017 via https://api.deepseek.com)
# High throughput (2,500 concurrency limit), ultra-low token pricing ($0.15/1M off-peak, $0.003 cache hit)
DEEPSEEK_API_KEY=
DEEPSEEK_API_KEY_SECONDARY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com/

# Tier 2: OpenRouter (Frontier Reasoning: NVIDIA Nemotron 3 Ultra 550B / Gemma 4 31B)
# Supports 4 API keys with automatic round-robin / rate-limit failover:
OPENROUTER_API_KEY=
OPENROUTER_API_KEY_SECONDARY=
OPENROUTER_API_KEY_3=
OPENROUTER_API_KEY_4=
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_FALLBACK_MODEL=google/gemma-4-31b-it:free

# Tier 3: Groq Cloud (Meta Llama 3.3 70B — 1,000 free requests/day)
GROQ_CONSOLE_API_KEY=
GROQ_DEFAULT_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1/

# Tier 4: Google Gemini (Gemini 2.0 Flash / Flash Thinking — 1,500 free requests/day)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Internal API key: shared secret for internal service calls (X-API-Key auth).
# If empty, internal-API requests are rejected with a logged warning.
# Generate with: openssl rand -hex 32
INTERNAL_API_KEY=

# Emergency off-switch for background jobs. If false, in-app notifications
# still work (written to Postgres); email and Telegram delivery is disabled
# and not retried; recurring jobs are skipped. NOT a normal setting — for
# cost spikes only.
HANGFIRE_ENABLED=true

# Telegram bot. If empty, Telegram endpoints are not mapped and Telegram
# notifications are skipped (email still delivers).
# Create via @BotFather on Telegram, then paste the token here.
TELEGRAM_BOT_TOKEN=

# Admin alert chat (error reports, scrape summaries).
TELEGRAM_CHAT_ID=

# Optional secret used to sign account-linking deep-link tokens. Falls back to
# INTERNAL_API_KEY, then TELEGRAM_BOT_TOKEN. Set a dedicated value in prod.
TELEGRAM_LINK_SECRET=

# Public channel where freshly-published jobs are broadcast as rich cards.
# Use @channelusername or the numeric id (-100…). Leave empty to disable.
# The bot must be an admin of the channel (with "Post Messages").
TELEGRAM_CHANNEL_ID=

# Force the channel on/off. Default: on when TELEGRAM_CHANNEL_ID is set.
TELEGRAM_CHANNEL_ENABLED=

# ── Telegram Bot Force-Join (Mandatory Channel Subscription) ─────────────────
# When true, users of @My_Serago_Bot must be members of the official channel before
# they can view job contacts, manage CVs, or configure alerts. Default: true when channel is set.
TELEGRAM_FORCE_JOIN_ENABLED=true

# Channel public username without '@' (e.g. "SeraGoJobs" or "SeraGo2026")
# Automatically derived from TELEGRAM_CHANNEL_ID if it starts with '@'.
TELEGRAM_CHANNEL_USERNAME=

# Direct invite URL used in the bot's "📢 Join Channel" button.
# Defaults to https://t.me/{TELEGRAM_CHANNEL_USERNAME} or https://t.me/SeraGo2026.
TELEGRAM_CHANNEL_INVITE_URL=

# ── Telegram Scheduled Messaging & Safe Testing Environment ──────────────────
# Test Channel: Redirects scheduled or test broadcasts to a staging/testing channel.
# If set, test sends in the Admin UI or in test mode go here instead of the production channel.
# Use @yourtestchannel or numeric ID (-100...).
TELEGRAM_TEST_CHANNEL_ID=

# Test Chat ID: Numeric Telegram user or chat ID for bot DM testing.
# When set, test bot DMs can be routed here without needing admin account linking.
# Find your ID with @userinfobot on Telegram.
TELEGRAM_TEST_CHAT_ID=

# Test Mode Guard:
# When true, all automated recurring Hangfire broadcasts (Morning, Afternoon, Night, Ads)
# are trapped and routed exclusively to TELEGRAM_TEST_CHANNEL_ID / TELEGRAM_TEST_CHAT_ID.
# Live subscribers and the production channel are guaranteed 100% zero spam.
# Set to false (or omit) when ready for live broadcasts.
TELEGRAM_MESSAGING_TEST_MODE=false

# How personalized job DMs are matched to a talent:
#   sector = jobs whose sector is in the talent's "For you" sectors
#   ai     = jobs where the talent's SeraGo-AI match score ≥ the threshold
#   both   = union of the two (default)
#   off    = no job DMs (channel broadcast still works)
TELEGRAM_JOB_DM_MODE=both

# Minimum 0-100 AI match score to DM a talent (ai / both modes). Default 60.
TELEGRAM_AI_SCORE_THRESHOLD=60

# Max personalized DMs created per job. Default 200.
TELEGRAM_JOB_DM_MAX_RECIPIENTS=200

# Seconds to wait before resolving AI-matched DMs, so SeraGo-AI has time to
# score the job after the publish webhook. Default 300.
TELEGRAM_AI_DM_DELAY_SECONDS=300

# Max channel posts per rate-limited sweep (Telegram allows ~20 msg/min per
# chat, so the sweep spaces posts out). Default 40.
TELEGRAM_CHANNEL_MAX_PER_RUN=40

# Click-through base for the channel button (job id is appended).
TELEGRAM_JOB_LINK_BASE=https://serago.pro.et/jobs

# Also fan out personalized DMs for scraper-synced jobs (bulk imports).
# Off by default to avoid flooding every matched talent.
TELEGRAM_SYNC_DM_ENABLED=false
TELEGRAM_SYNC_DM_MAX_JOBS=10

# Scraped-job auto-sync. If disabled, the admin sync endpoint still works —
# only the scheduled auto-sync is off. SYNC_SCHEDULE = UTC times (HH:mm).
SYNC_ENABLED=false
SYNC_SCHEDULE=09:15,20:45

# Email throttle (per-recipient anti-spam). Defaults shown; tune to protect
# your email provider's credits from repeated sends to one address.
EMAIL_THROTTLE_ENABLED=true
EMAIL_THROTTLE_MAX_PER_WINDOW=3
EMAIL_THROTTLE_WINDOW_MINUTES=15

# Auth endpoint rate limits (per IP, fixed window; RateLimiting__Auth*__*).
# auth_signin  — POST /api/auth/token, /api/auth/token/refresh, /api/auth/signin*
# auth_signup  — POST /api/auth/signup*
# auth_email   — POST /api/account/password/forgot + /email/confirm/resend
#                (per-IP on purpose; per-address capping is EmailThrottleService)
# Complements Identity's per-account lockout (5 fails → 5 min): the limiter
# caps an IP's TOTAL attempts, lockout caps attempts against ONE account.
RateLimiting__AuthSignin__PermitLimit=10
RateLimiting__AuthSignin__WindowMinutes=15
RateLimiting__AuthSignup__PermitLimit=5
RateLimiting__AuthSignup__WindowMinutes=60
RateLimiting__AuthEmail__PermitLimit=5
RateLimiting__AuthEmail__WindowMinutes=60


# ════════════════════════════════════════════════════════════════════════════
# ── DEV ONLY ─────────────────────────────────────────────────────────────────
# ════════════════════════════════════════════════════════════════════════════

# Write outgoing emails to SeraGo.API/logs/emails instead of sending them.
# Only honored in the Development environment — in Production this setting is
# ignored (so a prod deploy can never silently "send" emails to disk).
FluentEmail__SaveEmailsOnDisk=logs/emails


# ════════════════════════════════════════════════════════════════════════════
# ── Google OAuth setup checklist ─────────────────────────────────────────────
# ════════════════════════════════════════════════════════════════════════════
# 1. Google Cloud Console → APIs & Services → Credentials →
#    Create Credentials → OAuth Client ID (Web application).
# 2. Authorized redirect URI:
#        https://<api-host>/api/auth/external/callback/google
#    (local dev: https://localhost:5191/api/auth/external/callback/google)
# 3. Authorized JavaScript origin:
#        https://<frontend-host>
#    (local dev: https://localhost:5173)
# 4. Paste the ClientId and ClientSecret into
#        Aufy__Providers__Google__ClientId / ClientSecret
#    above, then restart the API. /api/auth/external/providers should list
#    "Google" once configured.
