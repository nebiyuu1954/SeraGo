# SeraGo API environment variables — copy to .env and fill in real values.

# Database connection (Neon/Postgres). Uses the __ -> : config mapping.
ConnectionStrings__DefaultConnection=Host=your-host;Database=your-db;Username=your-user;Password=your-password;sslmode=require

# EmailJS relay — see the one-time template setup in EmailJsSender.
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=

# Email throttle — max emails per address per window. Protects your EmailJS
# credits from users hammering "reset password" / "resend confirmation".
EMAIL_THROTTLE_ENABLED=true
EMAIL_THROTTLE_MAX_PER_WINDOW=3
EMAIL_THROTTLE_WINDOW_MINUTES=15
