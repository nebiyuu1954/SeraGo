{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Database=serago;Username=postgres;Password=postgres"
  },
  "Aufy": {
    "JwtBearer": {
      "SigningKey": "dev-only-signing-key-change-me-0123456789abcdef",
      "Issuer": "SeraGo.API",
      "Audience": "SeraGo.Client",
      "AccessTokenExpiresInMinutes": 15,
      "RefreshTokenExpireInHours": 720
    },
    "ClientApp": {
      "BaseUrl": "http://localhost:5173"
    },
    "Providers": {
      "Google": {
        "ClientId": "",
        "ClientSecret": "",
        "Scopes": [ "openid", "profile", "email" ]
      }
    }
  },
  "FluentEmail": {
    "FromEmail": "noreply@serago.local",
    "FromName": "SeraGo",
    "SaveEmailsOnDisk": "logs/emails",
    "SendGridApiKey": ""
  },
  "EmailJs": {
    "ServiceId": "",
    "TemplateId": "",
    "PublicKey": "",
    "PrivateKey": ""
  },
  "EmailThrottle": {
    "Enabled": true,
    "MaxEmailsPerWindow": 3,
    "WindowMinutes": 15
  },
  "RateLimiting": {
    "JobsRead": {
      "PermitLimit": 60,
      "WindowMinutes": 1
    },
    "JobsWrite": {
      "PermitLimit": 20,
      "WindowMinutes": 1
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
