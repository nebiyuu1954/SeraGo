{
  "ConnectionStrings": {
    "DefaultConnection": "DataSource=serago.db;Cache=Shared"
  },
  "Aufy": {
    "JwtBearer": {
      "SigningKey": "dev-only-signing-key-change-me-0123456789abcdef",
      "Issuer": "SeraGo.API",
      "Audience": "SeraGo.Client",
      "AccessTokenExpiresInMinutes": 15,
      "RefreshTokenExpireInHours": 720
    },
    "ClientApp": {
      "BaseUrl": "http://localhost:5173"
    },
    "Providers": {
      "Google": {
        "ClientId": "",
        "ClientSecret": "",
        "Scopes": [ "openid", "profile", "email" ]
      }
    }
  },
  "FluentEmail": {
    "FromEmail": "noreply@serago.local",
    "FromName": "SeraGo",
    "SaveEmailsOnDisk": "logs/emails"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
