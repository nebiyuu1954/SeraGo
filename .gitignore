# Markdown documentation — kept local, not tracked
*.md

# Architecture docs — any file/folder with 'architect' in the name
*architect*
*Architect*
*ARCHITECT*

# Environment variables (never commit secrets)
.env
.env.*
!.env.example

# .NET build artifacts
backend/**/bin/
backend/**/obj/
.vs/

# SQLite database files (local dev)
*.db
*.db-shm
*.db-wal

# Runtime logs & dev emails
backend/**/logs/
