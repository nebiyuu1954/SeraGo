# =============================================================================
# SeraGo Frontend (Vite / React) — Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values you have.
# =============================================================================

# ── App ───────────────────────────────────────────────────────────────────────
VITE_APP_NAME=SeraGo
VITE_APP_VERSION=0.1.0

# ── API ───────────────────────────────────────────────────────────────────────
# Point this at your deployed API in each environment.
# Local dev: HTTPS on 5191 (required for Google sign-in OAuth cookie).
# Staging:   https://api-staging.serago.com/api
# Production: https://api.serago.com/api
VITE_API_BASE_URL=https://localhost:5191/api

# ── Analytics (Google Analytics 4) ────────────────────────────────────────────
# GA4 Measurement ID for the web data stream (format: G-XXXXXXXXXX).
# Set this in PRODUCTION only — leave it empty in dev/staging so no test
# traffic reaches the property (analytics also stay off in dev builds).
VITE_GA_MEASUREMENT_ID=
